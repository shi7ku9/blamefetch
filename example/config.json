{
  "sections": {
    "blamefetch": {
      "name": "blamefetch {version}",
      "email": "self@blamefetch.invalid",
      "fields": {
        "version": {
          "command": "blamefetch --version | cut -d' ' -f2",
          "fallback": ""
        }
      }
    },
    "blank": "",
    "claude": {
      "name": "Claude {version}",
      "email": "noreply@anthropic.com",
      "fields": {
        "version": {
          "command": "claude --version | cut -d' ' -f1",
          "fallback": ""
        }
      }
    },
    "claude_text": "This commit is generated by Claude",
    "nvim": {
      "name": "Nvim {nvim_version}",
      "email": "editor@user.invalid",
      "fields": {
        "nvim_version": {
          "command": "nvim --version | cut -d' ' -f2 | cut -d$'\\n' -f1",
          "fallback": ""
        }
      }
    }
  },
